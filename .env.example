# Copy these into Vercel → Project → Settings → Environment Variables.

# "devnet" (test money, the default) or "mainnet-beta" (real money)
SOLANA_CLUSTER=devnet
# Optional but strongly recommended for mainnet: a private RPC URL (Helius, QuickNode, Triton…)
SOLANA_RPC_URL=

# REQUIRED. Encrypts every escrow wallet key. Generate with:  openssl rand -base64 32
# Back it up somewhere safe. If you lose or change it, funds in open escrows are stuck forever.
ESCROW_ENCRYPTION_KEY=

# REQUIRED. Email via resend.com
RESEND_API_KEY=
EMAIL_FROM=U GOT MAIL <mail@yourdomain.com>

# REQUIRED. Database. Added automatically when you connect Upstash Redis in the Vercel dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# REQUIRED. Protects the daily clean-up job. Any long random string:  openssl rand -hex 24
CRON_SECRET=

# Optional
RETURN_DAYS=30
SITE_URL=
